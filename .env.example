# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.

# Base de datos (PostgreSQL)
POSTGRES_DB=speedcube
POSTGRES_USER=speedcube
POSTGRES_PASSWORD=cambia-esto

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
# Para llegar desde el celular agrega la IP o el nombre del PC servidor, p. ej. 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados a usar la API (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173
