# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.
# Es la única configuración de toda la aplicación: docker compose lo lee solo.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=speedcube
POSTGRES_USER=speedcube
POSTGRES_PASSWORD=cambia-esto
# Puerto del PC para llegar a PostgreSQL desde herramientas externas (DBeaver, pgAdmin...).
# Solo se publica en este PC. Dentro de Docker el backend siempre usa db:5432.
DB_HOST_PORT=5433

# --- Django (backend) ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
# # Nombres con los que se puede llamar al backend. Para llegar desde el celular agrega la IP del PC,
# p. ej. 192.168.1.50 (localhost y 127.0.0.1 siempre quedan permitidos).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Páginas web autorizadas a usar la API. El frontend de Docker se sirve en el 5173.
# Desde el celular agrega también http://192.168.1.50:5173 (separados por comas, con http://).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Orígenes de confianza para el formulario del panel /admin (con http://, separados por comas).
# Solo hay que tocarlo si abres el /admin detrás de un proxy o desde otra dirección.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
