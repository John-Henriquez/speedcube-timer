# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.
# Es la única configuración de toda la aplicación: docker compose lo lee solo.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=speedcube
POSTGRES_USER=speedcube
POSTGRES_PASSWORD=cambia-esto
# Puerto del PC para llegar a PostgreSQL desde herramientas externas (DBeaver, pgAdmin...).
# Solo se publica en este PC. Dentro de Docker el backend siempre usa db:5432.
DB_HOST_PORT=5433

# --- Django (backend) ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
# # Nombres con los que se puede llamar al backend. Para llegar desde el celular agrega la IP del PC,
# p. ej. 192.168.1.50 (localhost y 127.0.0.1 siempre quedan permitidos).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Páginas web autorizadas a usar la API. El frontend de Docker se sirve en el 5173.
# Desde el celular agrega también http://192.168.1.50:5173 (separados por comas, con http://).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Orígenes de confianza para el formulario del panel /admin (con http://, separados por comas).
# Solo hay que tocarlo si abres el /admin detrás de un proxy o desde otra dirección.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Cuentas ---
# Días que dura una sesión sin volver a iniciar sesión.
AUTH_TOKEN_TTL_DAYS=30
# Intentos por hora y por IP en registro, inicio de sesión, recuperación de contraseña y Google (frena la fuerza bruta).
AUTH_THROTTLE_RATE=30/hour
# Dirección del frontend: se usa en los enlaces de los correos de recuperación de contraseña.
# Desde el celular sería, p. ej., http://192.168.1.50:5173
FRONTEND_URL=http://localhost:5173
# Dirección del backend vista desde el navegador. Vacío = el mismo equipo que sirve la página, puerto 8000
# (es lo normal, también desde el celular). Se incorpora al compilar el frontend.
VITE_API_URL=

# --- Inicio de sesión con Google (opcional) ---
# Vacío = el botón de Google no aparece. Para activarlo crea un "ID de cliente de OAuth" de tipo "Aplicación web" en
# https://console.cloud.google.com/apis/credentials y agrega como origen autorizado http://localhost:5173.
# Es un identificador público (no un secreto). Se incorpora al compilar el frontend: reconstruye con --build.
GOOGLE_CLIENT_ID=

# --- Correo para recuperar contraseñas (opcional) ---
# Por defecto los correos NO se envían: se escriben en los registros del backend (docker compose logs backend),
# suficiente para uso personal. Para enviarlos de verdad, descomenta y completa con tu servidor SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Speedcube Timer <no-reply@example.com>
